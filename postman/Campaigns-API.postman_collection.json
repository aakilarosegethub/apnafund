			"name": "0. Login (token)",
			"item": [
				{
					"name": "user_login.php",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "mobile", "value": "{{user_email}}", "description": "Email ya mobile number" },
								{ "key": "password", "value": "{{user_password}}" },
								{ "key": "ccode", "value": "{{ccode}}", "description": "Sirf mobile login par zaroori" }
							]
						},
						"url": "{{base_url}}/api/user_login.php"
					}
				}
			]
		},
