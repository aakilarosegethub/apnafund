<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /apnafund/

    # # =====================================
    # # 1️⃣ BYPASS Laravel for CORE PHP API
    # # URL: /api/file.php
    # # =====================================
    # RewriteCond %{REQUEST_URI} ^/apnafund/api/
    # RewriteCond %{DOCUMENT_ROOT}/apnafund/api -d
    # RewriteRule ^ - [L]

    # =====================================
    # 2️⃣ Assets WITHOUT Laravel
    # =====================================
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^admin/assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # =====================================
    # 3️⃣ Admin / User / IPN → Laravel
    # =====================================
    RewriteRule ^admin(.*)$ public/index.php [L,QSA]
    RewriteRule ^user(.*)$ public/index.php [L,QSA]
    RewriteRule ^ipn(.*)$ public/index.php [L,QSA]

    # =====================================
    # API Routes - Route all API calls to Laravel (even if file exists)
    # =====================================
    RewriteCond %{REQUEST_URI} ^/apnafund/api/
    RewriteRule ^api/(.*)$ public/index.php [L,QSA]

    # =====================================
    # 4️⃣ Everything else → Laravel
    # =====================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [L]
</IfModule>

Options -Indexes
