{
	"info": {
		"_postman_id": "fund-apis-collection-2024",
		"name": "Fund APIs (Token Required)",
		"description": "Fund Create, Edit and List APIs - All require Bearer Token authentication",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Fund List",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "Bearer token from login API response"
					},
					{
						"key": "Content-Type",
						"value": "application/x-www-form-urlencoded",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "status",
							"value": "Pending",
							"type": "text",
							"description": "Options: Pending, Cancelled, Completed"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/api/fundlist.php",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"fundlist.php"
					]
				},
				"description": "Get list of funds/campaigns for logged in user. Requires Bearer token.\n\nStatus options:\n- Pending: Shows pending campaigns\n- Cancelled: Shows cancelled campaigns\n- Completed: Shows completed campaigns"
			},
			"response": []
		},
