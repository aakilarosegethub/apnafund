							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"reset_password.php"
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"cookie": [],
					"body": "{\n    \"ResponseCode\": \"200\",\n    \"Result\": \"true\",\n    \"ResponseMsg\": \"Password reset successfully! Email notification sent.\"\n}"
				},
