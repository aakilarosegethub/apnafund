{
	"info": {
		"_postman_id": "ApnaCrowdfunding-token-based-api",
		"name": "ApnaCrowdfunding API - Token Based Authentication",
						"description": "Complete API collection for ApnaCrowdfunding with Laravel Sanctum token-based authentication. All protected APIs require Bearer token in Authorization header. No need to send 'uid' in request body for protected APIs.\n\n**Environment Variables Required:**\n- `base_url`: API base URL (e.g., http://127.0.0.1:8000)\n- `auth_token`: Bearer token for authentication (automatically saved after login/registration)\n\n**Setup Instructions:**\n1. Create a Postman Environment\n2. Add `base_url` and `auth_token` variables\n3. Login/Register to automatically save token to `auth_token` environment variable",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{auth_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "User Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.environment.set('auth_token', jsonData.token);",
									"        console.log('Token saved to environment:', jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"mobile\": \"1234567890\",\n    \"password\": \"password123\",\n    \"ccode\": \"+1\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/reg_user.php",
							"host": ["{{base_url}}"],
							"path": ["api", "reg_user.php"]
						},
						"description": "Register a new user. Returns token in response. Token is automatically saved to environment variable 'auth_token'."
					},
